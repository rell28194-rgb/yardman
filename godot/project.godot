; Yardman - open source runtime project
; Generated for the non-Unity Android beta pipeline.

config_version=5

[application]
config/name="Yardman"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
RenderRuntime="*res://scripts/render_runtime.gd"
BuildingHLOD="*res://scripts/building_hlod_runtime.gd"
RoadVisibilityRuntime="*res://scripts/road_visibility_runtime.gd"
TrafficRuntime="*res://scripts/traffic_runtime.gd"
TrafficSignalRuntime="*res://scripts/traffic_signal_runtime.gd"
ParkedVehicleRuntime="*res://scripts/parked_vehicle_runtime.gd"
PedestrianRuntime="*res://scripts/pedestrian_runtime.gd"
PedestrianDestinationRuntime="*res://scripts/pedestrian_destination_runtime.gd"
PedestrianIdleRuntime="*res://scripts/pedestrian_idle_runtime.gd"
TrafficPedestrianSafetyRuntime="*res://scripts/traffic_pedestrian_safety_runtime.gd"
TrafficVisualVarietyRuntime="*res://scripts/traffic_visual_variety_runtime.gd"
StreetlightNightRuntime="*res://scripts/streetlight_night_runtime.gd"
VehicleHeadlightRuntime="*res://scripts/vehicle_headlight_runtime.gd"
TrafficHeadlightRuntime="*res://scripts/traffic_headlight_runtime.gd"
BuildingNightRuntime="*res://scripts/building_night_runtime.gd"
EnvironmentAudioRuntime="*res://scripts/environment_audio_runtime.gd"
VehicleSignalRuntime="*res://scripts/vehicle_signal_runtime.gd"
JobRuntime="*res://scripts/job_runtime.gd"
JobPersistenceRuntime="*res://scripts/job_persistence_runtime.gd"
JobGuidanceRuntime="*res://scripts/job_guidance_runtime.gd"
VegetationBudgetRuntime="*res://scripts/vegetation_budget_runtime.gd"
ReflectionBudgetRuntime="*res://scripts/reflection_budget_runtime.gd"
ShaderWarmup="*res://scripts/shader_warmup.gd"
VehicleGarage="*res://scripts/vehicle_garage.gd"
VehicleVisualRuntime="*res://scripts/vehicle_visual_runtime.gd"
VehicleCameraRuntime="*res://scripts/vehicle_camera_runtime.gd"
SurfaceDynamics="*res://scripts/surface_dynamics_runtime.gd"
RoadworkLayer="*res://scripts/roadwork_layer.gd"
FenceLayer="*res://scripts/fence_layer.gd"
StreetLightLayer="*res://scripts/streetlight_layer.gd"
GuardRailLayer="*res://scripts/guardrail_layer.gd"
BusStopLayer="*res://scripts/bus_stop_layer.gd"
VehicleDriverLayer="*res://scripts/vehicle_driver_layer.gd"
StartupMenu="*res://scripts/startup_menu.gd"
AtmosphereFX="*res://scripts/atmosphere_fx.gd"
WeatherCycleRuntime="*res://scripts/weather_cycle_runtime.gd"
LocationTracker="*res://scripts/location_tracker.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
; Desktop/headless validation stays on Compatibility. Android defaults to the
; Vulkan Mobile renderer per godot-android-gpu.md; a separately exported GLES
; fallback remains a distinct build/test path rather than silent auto-fallback.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/enable_pause_aware_picking=true

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Vehicle"
3d_physics/layer_3="Player"
