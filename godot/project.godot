; Yardman owner recovery runtime
; Full Jamaica + player vehicles. No jobs, AI traffic, pedestrian simulation, or economy autoloads.

config_version=5

[application]
config/name="Yardman"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
MapQualityBootstrap="*res://scripts/map_quality_bootstrap.gd"
RenderRuntime="*res://scripts/render_runtime.gd"
BuildingHLOD="*res://scripts/building_hlod_runtime.gd"
VegetationBudgetRuntime="*res://scripts/vegetation_budget_runtime.gd"
ReflectionBudgetRuntime="*res://scripts/reflection_budget_runtime.gd"
ShaderWarmup="*res://scripts/shader_warmup.gd"
VehicleGarage="*res://scripts/vehicle_selector_runtime.gd"
VehicleVisualRuntime="*res://scripts/vehicle_visual_runtime.gd"
VehicleCameraRuntime="*res://scripts/vehicle_camera_runtime.gd"
VehicleHeadlightRuntime="*res://scripts/vehicle_headlight_runtime.gd"
VehicleSignalRuntime="*res://scripts/vehicle_signal_runtime.gd"
StreetlightNightRuntime="*res://scripts/streetlight_night_runtime.gd"
BuildingNightRuntime="*res://scripts/building_night_runtime.gd"
AtmosphereFX="*res://scripts/atmosphere_fx.gd"
WeatherCycleRuntime="*res://scripts/weather_cycle_runtime.gd"
LocationTracker="*res://scripts/location_tracker.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
; Restore the reset/Beta presentation path instead of silently moving the owner build to Vulkan Mobile.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/enable_pause_aware_picking=true

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Vehicle"
3d_physics/layer_3="Player"
